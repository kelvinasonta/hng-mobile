# AETHER Mobile Configuration Template
# Copy this file to .env and configure your Web API server URL
# - For iOS Simulator / Web: http://localhost:3000
# - For Android Emulator: http://10.0.2.2:3000
# - For Physical Device (Expo Go): http://YOUR_COMPUTER_LOCAL_IP:3000 (e.g., http://192.168.1.15:3000)
EXPO_PUBLIC_API_URL=http://localhost:3000
