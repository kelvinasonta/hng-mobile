{
  "expo": {
    "name": "AETHER",
    "slug": "aether-mobile",
    "scheme": "aether",
    "version": "1.0.0",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aether.hardware"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07090e"
      },
      "package": "com.aether.hardware"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "f32efff7-9c1d-4a9c-9a39-1cd676d87bae"
      }
    }
  }
}
